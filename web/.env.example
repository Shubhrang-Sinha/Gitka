DATABASE_URL=postgresql://devplatform:YOUR_PASSWORD@127.0.0.1:5433/devplatform
FORGEJO_URL=http://localhost:3001
# Set when browsers use a different address from the server-to-server API.
FORGEJO_PUBLIC_URL=
FORGEJO_TOKEN=your_forgejo_token_here
FORGEJO_WRITE_TOKEN=your_forgejo_write_token_here
# Register a public OAuth application with this exact callback URL in Forgejo.
FORGEJO_OAUTH_CLIENT_ID=
FORGEJO_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/forgejo/callback
# Generate a stable 32-byte key with: openssl rand -hex 32
FORGEJO_TOKEN_ENCRYPTION_KEY=
# Set locally for bun run seed:demo. The seed provisions both Forgejo tokens.
GITKA_DEMO_PASSWORD=
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LLM_MODEL=openrouter/free
# Optional OpenRouter embedding model for codebase Q&A. Refresh the index after changing it.
QA_EMBEDDING_MODEL=
FORGEJO_WEBHOOK_SECRET=paste_the_generated_value_here
